# Copy this file to .env, fill in your provider credentials, then restart the backend.
# .env and .env.* are ignored by Git; never put credentials in frontend code.
# API teaching requires both LLM_API_KEY and LLM_MODEL. There is no offline tutor.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
